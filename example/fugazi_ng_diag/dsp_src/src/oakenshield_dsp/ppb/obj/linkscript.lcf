ENTRY("_start")

MEMORY
{
 VECT     (RWX)  : ORIGIN = 0x00000000, LENGTH = 0x100
 RSTM     (RXW) :  ORIGIN = 0x00000108, LENGTH = 0x400
 PPB      (RWX)  : ORIGIN = 0x00000400, LENGTH = 0x5f8c0
 JUMP     (RX)   : ORIGIN = 0x0005AFC0, LENGTH = 0x00040
 PPB2     (RWX)  : ORIGIN = 0x0005B000, LENGTH = 5K
 PPB3     (RWX)  : ORIGIN = 0x00060000, LENGTH = 128K
 DSS0     (RWX)  : ORIGIN = 0x80000000, LENGTH = 256K
 DSS1     (RWX)  : ORIGIN = 0x82000000, LENGTH = 256K
 DSS2     (RWX)  : ORIGIN = 0x84000000, LENGTH = 256K
 DSS3     (RWX)  : ORIGIN = 0x86000000, LENGTH = 256K
 SRIO0    (RWX)  : ORIGIN = 0xA0000000, LENGTH = 256M
 SRIO1    (RWX)  : ORIGIN = 0xB0000000, LENGTH = 256M
 SYSMEM   (RW)   : ORIGIN = 0xC0000000, LENGTH = 0x60000
/* PPB should not use SYSMEM at all
 SYSMEM0  (RWX)  : ORIGIN = 0xC0000000, LENGTH = 510K
 SYSMEM1  (RWX)  : ORIGIN = 0xC0080000, LENGTH = 512K
 SYSMEM2  (RWX)  : ORIGIN = 0xC0100000, LENGTH = 512K
 SYSMEM3  (RWX)  : ORIGIN = 0xC0180000, LENGTH = 512K
 SYSMEM4  (RWX)  : ORIGIN = 0xC0200000, LENGTH = 512K
 SYSMEM5  (RWX)  : ORIGIN = 0xC0280000, LENGTH = 512K
 SYSMEM6  (RWX)  : ORIGIN = 0xC0300000, LENGTH = 512K
 SYSMEM7  (RWX)  : ORIGIN = 0xC0380000, LENGTH = 512K
 SYSMEM8  (RWX)  : ORIGIN = 0xC0400000, LENGTH = 512K
 SYSMEM9  (RWX)  : ORIGIN = 0xC0480000, LENGTH = 512K
 SYSMEM10 (RWX)  : ORIGIN = 0xC0500000, LENGTH = 512K
 SYSMEM11 (RWX)  : ORIGIN = 0xC0580000, LENGTH = 446K
 SYSMEM12 (RWX)  : ORIGIN = 0xC0600000, LENGTH = 512K
 SYSMEM13 (RWX)  : ORIGIN = 0xC0680000, LENGTH = 512K
 SYSMEM14 (RWX)  : ORIGIN = 0xC0700000, LENGTH = 512K
 SYSMEM15 (RWX)  : ORIGIN = 0xC0780000, LENGTH = 512K
*/
 /* reserve top 1M - 64K (IROM) DDR memory for PPB */
 FPGA_IMG (RX)   : ORIGIN = 0xFF900000, LENGTH = 0x400000
 DDR3     (RWX)  : ORIGIN = 0xFFF00000, LENGTH = 0xF0000


 SHMMEM_PPB0_PPB1 (RWX) : ORIGIN = 0xC05F2A00, LENGTH = 2K

 SHMMEM_DSS0_DSS1_BUF (RWX) : ORIGIN = 0xC05F3200, LENGTH = 4K
 SHMMEM_DSS0_DSS2_BUF (RWX) : ORIGIN = 0xC05F4200, LENGTH = 4K
 SHMMEM_DSS0_DSS3_BUF (RWX) : ORIGIN = 0xC05F5200, LENGTH = 4K
 SHMMEM_DSS1_DSS0_BUF (RWX) : ORIGIN = 0xC05F6200, LENGTH = 4K
 SHMMEM_DSS1_DSS2_BUF (RWX) : ORIGIN = 0xC05F7200, LENGTH = 4K
 SHMMEM_DSS1_DSS3_BUF (RWX) : ORIGIN = 0xC05F8200, LENGTH = 4K
 SHMMEM_DSS2_DSS0_BUF (RWX) : ORIGIN = 0xC05F9200, LENGTH = 4K
 SHMMEM_DSS2_DSS1_BUF (RWX) : ORIGIN = 0xC05FA200, LENGTH = 4K
 SHMMEM_DSS2_DSS3_BUF (RWX) : ORIGIN = 0xC05FB200, LENGTH = 4K
 SHMMEM_DSS3_DSS0_BUF (RWX) : ORIGIN = 0xC05FC200, LENGTH = 4K
 SHMMEM_DSS3_DSS1_BUF (RWX) : ORIGIN = 0xC05FD200, LENGTH = 4K
 SHMMEM_DSS3_DSS2_BUF (RWX) : ORIGIN = 0xC05FE200, LENGTH = 4K

 SHMMEM_DSS0_PPB0 (RWX) : ORIGIN = 0xC05FF200, LENGTH = 128
 SHMMEM_PPB0_DSS0 (RWX) : ORIGIN = 0xC05FF280, LENGTH = 128

 SHMMEM_DSS0_PPB1 (RWX) : ORIGIN = 0xC05FF300, LENGTH = 128
 SHMMEM_PPB1_DSS0 (RWX) : ORIGIN = 0xC05FF380, LENGTH = 128

 SHMMEM_DSS1_PPB0 (RWX) : ORIGIN = 0xC05FF400, LENGTH = 128
 SHMMEM_PPB0_DSS1 (RWX) : ORIGIN = 0xC05FF480, LENGTH = 128

 SHMMEM_DSS1_PPB1 (RWX) : ORIGIN = 0xC05FF500, LENGTH = 128
 SHMMEM_PPB1_DSS1 (RWX) : ORIGIN = 0xC05FF580, LENGTH = 128

 SHMMEM_DSS2_PPB0 (RWX) : ORIGIN = 0xC05FF600, LENGTH = 128
 SHMMEM_PPB0_DSS2 (RWX) : ORIGIN = 0xC05FF680, LENGTH = 128

 SHMMEM_DSS2_PPB1 (RWX) : ORIGIN = 0xC05FF700, LENGTH = 128
 SHMMEM_PPB1_DSS2 (RWX) : ORIGIN = 0xC05FF780, LENGTH = 128

 SHMMEM_DSS3_PPB0 (RWX) : ORIGIN = 0xC05FF800, LENGTH = 128
 SHMMEM_PPB0_DSS3 (RWX) : ORIGIN = 0xC05FF880, LENGTH = 128

 SHMMEM_DSS3_PPB1 (RWX) : ORIGIN = 0xC05FF900, LENGTH = 128
 SHMMEM_PPB1_DSS3 (RWX) : ORIGIN = 0xC05FF980, LENGTH = 128

 SHMMEM_DSS0_DSS1 (RWX) : ORIGIN = 0xC05FFA00, LENGTH = 128
 SHMMEM_DSS1_DSS0 (RWX) : ORIGIN = 0xC05FFA80, LENGTH = 128

 SHMMEM_DSS0_DSS2 (RWX) : ORIGIN = 0xC05FFB00, LENGTH = 128
 SHMMEM_DSS2_DSS0 (RWX) : ORIGIN = 0xC05FFB80, LENGTH = 128

 SHMMEM_DSS0_DSS3 (RWX) : ORIGIN = 0xC05FFC00, LENGTH = 128
 SHMMEM_DSS3_DSS0 (RWX) : ORIGIN = 0xC05FFC80, LENGTH = 128

 SHMMEM_DSS1_DSS2 (RWX) : ORIGIN = 0xC05FFD00, LENGTH = 128
 SHMMEM_DSS2_DSS1 (RWX) : ORIGIN = 0xC05FFD80, LENGTH = 128

 SHMMEM_DSS1_DSS3 (RWX) : ORIGIN = 0xC05FFE00, LENGTH = 128
 SHMMEM_DSS3_DSS1 (RWX) : ORIGIN = 0xC05FFE80, LENGTH = 128

 SHMMEM_DSS2_DSS3 (RWX) : ORIGIN = 0xC05FFF00, LENGTH = 128
 SHMMEM_DSS3_DSS2 (RWX) : ORIGIN = 0xC05FFF80, LENGTH = 128
}



SECTIONS
{

 VECT :
 {
	/* Don't place anything here.  odo_exception needs to be at 0x00000000 */
 } > VECT
 
 .PPB :
 {
 } > PPB

 .PPB2 :
 {
 } > PPB2

 .PPB3 :
 {
  	/* Don't use PPB3 physical mem - Reserved for ARM1 local data */
 } > PPB3

 /* .resetVec Section always at address 0 */
 .first 0x0 :
 {
  *(.first)
  *(.gnu.warning)
  *(.gnu.linkonce.t.*)
 } > VECT

 .reset_msg (NOLOAD):
 {
	*(RESET_MSG)
 } > PPB

.jump :
{
	*(.bootjump)
} > JUMP

.chksumtab ALIGN(4) :
{
  *(.chksumtab)
  *(.ipaddr)
} > PPB2

 .text :
 {
  *(.rsthdlr)
  *(.text)
  *(.text.*)
  *(*glue_7*)
  *(*glue_7t*)
  *(.stub)
  *(.init*)
  *(.fini*)
  *(.gnu.warning)
  *(.gnu.linkonce.t.*)
 } > DDR3

 .fpga_image :
 {
   *(.fpga_image)
 } > FPGA_IMG

 .ctors :
 {
  *(.ctors)
  *(SORT(.ctors.*))
 } > PPB

 .dtors :
 {
  *(.dtors)
  *(SORT(.dtors.*))
 } > PPB

 .eh_frame ALIGN(0x10):
 {
  *(.eh_frame)
 } > PPB

 .rodata :
 {
  *(.rodata)
  *(.rodata.*)
  *(.gnu.linkonce.r.*)
 } > PPB

 .gcc_except_table ALIGN(0x10) :
 {
  *(.gcc_except_table)
 } > PPB

 .init_data ALIGN(0x10) :
 {
 } > PPB



 .data ALIGN(0x10) : AT(ADDR(.init_data)) 
 {
  LONG(0xDEADBABE)
  *(.data)
  *(.data.*)
  *(.gnu.linkonce.d.*)
  SORT(CONSTRUCTORS)
 } > PPB

 . = . + SIZEOF(.data);

 .sdata ALIGN(0x10) :
 {
  *(.sdata)
  *(.sdata.*)
  *(.gnu.linkonce.s.*)
 } > PPB

 . = ASSERT((0x9000 >= (SIZEOF(.data) + SIZEOF(.sdata))),
     "INIT_DATA_SIZE too small");


 .sbss :
 {
  *(.sbss)
  *(.sbss.*)
  *(.scommon)
  *(.gnu.linkonce.sb.*)
 } > PPB

 .bss :
 {
  *(.bss)
  *(.bss.*)
  *(COMMON)
  *(.gnu.linkonce.b.*)
 } > PPB

 .armddr2 :
 {
   *(.armddr2)
 } > DDR3

 .shmem_ppb0_ppb1 (NOLOAD):
 {
 } > SHMMEM_PPB0_PPB1

 .shmem_dss0_ppb0 (NOLOAD):
 {
 } > SHMMEM_DSS0_PPB0
 .shmem_ppb0_dss0 (NOLOAD):
 {
 } > SHMMEM_PPB0_DSS0
 .shmem_dss0_ppb1 (NOLOAD):
 {
 } > SHMMEM_DSS0_PPB1
 .shmem_ppb1_dss0 (NOLOAD):
 {
 } > SHMMEM_PPB1_DSS0
 .shmem_dss1_ppb0 (NOLOAD):
 {
 } > SHMMEM_DSS1_PPB0
 .shmem_ppb0_dss1 (NOLOAD):
 {
 } > SHMMEM_PPB0_DSS1
 .shmem_dss1_ppb1 (NOLOAD):
 {
 } > SHMMEM_DSS1_PPB1
 .shmem_ppb1_dss1 (NOLOAD):
 {
 } > SHMMEM_PPB1_DSS1
 .shmem_dss2_ppb0 (NOLOAD):
 {
 } > SHMMEM_DSS2_PPB0
 .shmem_ppb0_dss2 (NOLOAD):
 {
 } > SHMMEM_PPB0_DSS2
 .shmem_dss2_ppb1 (NOLOAD):
 {
 } > SHMMEM_DSS2_PPB1
 .shmem_ppb1_dss2 (NOLOAD):
 {
 } > SHMMEM_PPB1_DSS2
 .shmem_dss3_ppb0 (NOLOAD):
 {
 } > SHMMEM_DSS3_PPB0
 .shmem_ppb0_dss3 (NOLOAD):
 {
 } > SHMMEM_PPB0_DSS3
 .shmem_dss3_ppb1 (NOLOAD):
 {
 } > SHMMEM_DSS3_PPB1
 .shmem_ppb1_dss3 (NOLOAD):
 {
 } > SHMMEM_PPB1_DSS3
 .shmem_dss0_dss1 (NOLOAD):
 {
 } > SHMMEM_DSS0_DSS1
 .shmem_dss1_dss0 (NOLOAD):
 {
 } > SHMMEM_DSS1_DSS0
 .shmem_dss0_dss2 (NOLOAD):
 {
 } > SHMMEM_DSS0_DSS2
 .shmem_dss2_dss0 (NOLOAD):
 {
 } > SHMMEM_DSS2_DSS0
 .shmem_dss0_dss3 (NOLOAD):
 {
 } > SHMMEM_DSS0_DSS3
 .shmem_dss3_dss0 (NOLOAD):
 {
 } > SHMMEM_DSS3_DSS0
 .shmem_dss1_dss2 (NOLOAD):
 {
 } > SHMMEM_DSS1_DSS2
 .shmem_dss2_dss1 (NOLOAD):
 {
 } > SHMMEM_DSS2_DSS1
 .shmem_dss1_dss3 (NOLOAD):
 {
 } > SHMMEM_DSS1_DSS3
 .shmem_dss3_dss1 (NOLOAD):
 {
 } > SHMMEM_DSS3_DSS1
 .shmem_dss2_dss3 (NOLOAD):
 {
 } > SHMMEM_DSS2_DSS3
 .shmem_dss3_dss2 (NOLOAD):
 {
 } > SHMMEM_DSS3_DSS2


 .nvram (NOLOAD) :
 {
  *(.nvram)
 } > PPB2


 .ignore (NOLOAD) :
 {
  *(.rel.dyn)
  *(.rel.plt)
 } > PPB


 /* Allocate heap and all stacks in remaining memory at the end of PPBMEM */
__LEFTOVER = LENGTH(PPB3);

 /* stack grows down in memory */
__IRQ_SP_INIT = ORIGIN(PPB3) + LENGTH(PPB3);
__IRQ_STK_SZ = 0x100;
__FIQ_SP_INIT = __IRQ_SP_INIT - __IRQ_STK_SZ;
__FIQ_STK_SZ = 0x80;
__ABT_SP_INIT = __FIQ_SP_INIT - __FIQ_STK_SZ;
__ABT_STK_SZ = 0x40;
__SVC_SP_INIT = __ABT_SP_INIT - __ABT_STK_SZ;
__SVC_STK_SZ = 0x40;

/* user stack pointer */
__USR_STK_SZ = __LEFTOVER - __IRQ_STK_SZ - __FIQ_STK_SZ - __ABT_STK_SZ - __SVC_STK_SZ - 0x10;  /* 16-byte 'pad' */

 .init_stack (NOLOAD) :
 {
  . = . + __USR_STK_SZ; */
 } > PPB3  
 
/* user stack pointer - stack grows down */
__USP_INIT = ADDR(.init_stack) + __USR_STK_SZ ;
 
/* address of start of heap - heap grows up */
end = ADDR(.init_stack);
 
 .svc_stack (NOLOAD) :
 {
  . = . + __SVC_STK_SZ;
 } > PPB3

 .abt_stack (NOLOAD) :
 {
  . = . + __ABT_STK_SZ;
 } > PPB3

 .fiq_stack (NOLOAD) :
 {
  . = . + __FIQ_STK_SZ;
 } > PPB3

 .irq_stack (NOLOAD) :
 {
  . = . + __IRQ_STK_SZ;
 } > PPB3

/* NO PPB sections past this point */


/*---------------------------------------------------------------------------
 *              Debug information
 *-------------------------------------------------------------------------*/

        /*
         * DWARF debug sections.
         */

        /* DWARF 1 */
        .debug           0 : { *(.debug) }
        .line            0 : { *(.line) }
        /* GNU DWARF 1 extensions */
        .debug_srcinfo   0 : { *(.debug_srcinfo) }
        .debug_sfnames   0 : { *(.debug_sfnames) }
        /* DWARF 1.1 and DWARF 2 */
        .debug_aranges   0 : { *(.debug_aranges) }
        .debug_pubnames  0 : { *(.debug_pubnames) }
        /* DWARF 2 */
        .debug_info      0 : { *(.debug_info) *(.gnu.linkonce.wi.*) }
        .debug_abbrev    0 : { *(.debug_abbrev) }
        .debug_line      0 : { *(.debug_line) }
        .debug_frame     0 : { *(.debug_frame) }
        .debug_str       0 : { *(.debug_str) }
        .debug_loc       0 : { *(.debug_loc) }
        .debug_macinfo   0 : { *(.debug_macinfo) }
        /* SGI/MIPS DWARF 2 extensions */
        .debug_weaknames 0 : { *(.debug_weaknames) }
        .debug_funcnames 0 : { *(.debug_funcnames) }
        .debug_typenames 0 : { *(.debug_typenames) }
        .debug_varnames  0 : { *(.debug_varnames) }

	/*-----------------------------------------------------------------
	 * HW Registers
	 *---------------------------------------------------------------*/

	.pce_regs_section 0x30040000  (NOLOAD) :
	{
		*(pce_regs)
	}
	.txd_regs_section 0x30043000  (NOLOAD) :
	{
		*(txd_regs)
	}
	.mac_regs_section 0x30044000  (NOLOAD) :
	{
		*(mac_regs)
	}
	.car_regs_section 0x98012000  (NOLOAD) :
	{
		*(car_regs)
	}
	.dbm_regs_section 0x98050000  (NOLOAD) :
	{
		*(dbm_regs)
	}
	.dss0_regs_section 0x98000000  (NOLOAD) :
	{
		*(dss0_regs)
	}
	.dss1_regs_section 0x98002000  (NOLOAD) :
	{
		*(dss1_regs)
	}
	.dss2_regs_section 0x98060000  (NOLOAD) :
	{
		*(dss2_regs)
	}
	.dss3_regs_section 0x98062000  (NOLOAD) :
	{
		*(dss3_regs)
	}
	.gpio_regs_section 0x30046000  (NOLOAD) :
	{
		*(gpio_regs)
	}
	.mdio_regs_section 0x3004E000  (NOLOAD) :
	{
		*(mdio_regs)
	}
	.gige_serdes_regs_section 0x30020000  (NOLOAD) :
	{
		*(serdes_regs)
	}
	.armctl_regs_section 0x30045000  (NOLOAD) :
	{
		*(armctl_regs)
	}
	.arm_timer_regs_section 0x0C000600  (NOLOAD) :
	{
		*(arm_timer_regs)
	}
	.tdm_regs_section 0x98010000  (NOLOAD) :
	{
		*(tdm_regs)
	}
	.uart_regs_section 0x30047000  (NOLOAD) :
	{
		*(uart_regs)
	}
	.ssp_regs_section 0x3004F000  (NOLOAD) :
	{
		*(ssp_regs)
	}
	.gt_timer_regs_section 0x98013000  (NOLOAD) :
	{
		*(gt_timer_regs)
	}
	.trng_regs_section 0x30008000  (NOLOAD) :
	{
		*(trng_regs)
	}
	.nand_regs_section 0x30010000  (NOLOAD) :
	{
		*(nand_regs)
	}
	.dmac31_regs_section 0x98001000  (NOLOAD) :
	{
		*(dmac31_regs)
	}	
	.pcie_regs_section 0x9B010000  (NOLOAD) :
	{
		*(pcie_regs)
	}	
	.pcie_serdes_regs_section 0x9B004000  (NOLOAD) :
	{
		*(pcie_serdes_regs)
	}	
	.srio_serdes_regs_section 0x9B000000  (NOLOAD) :
	{
		*(srio_serdes_regs)
	}	
	.ddr3_phy_section 0x98030000  (NOLOAD) :
	{
		*(ddr3_phy_regs)
	}	
}

__TEXT_START = ADDR(.text);
__TEXT_END = __TEXT_START + SIZEOF(.text);

__RAM_START = ADDR(.data);
__RAM_END = ADDR(.init_stack) + SIZEOF(.init_stack);

__DATA_ROM = ADDR(.init_data);
__DATA_RAM = ADDR(.data);
__DATA_END = ADDR(.sdata) + SIZEOF(.sdata);
__BSS_START = ADDR(.sbss);
__BSS_END = ADDR(.bss) + SIZEOF(.bss);
__SP_INIT = __RAM_END;

end = ADDR(.bss) + SIZEOF(.bss);
__CTOR_LIST__ = ADDR(.ctors);
__CTOR_END__ = ADDR(.ctors) + SIZEOF(.ctors);
__DTOR_LIST__ = ADDR(.dtors);
__DTOR_END__ = ADDR(.dtors) + SIZEOF(.dtors);
__EH_FRAME_BEGIN__ = ADDR(.eh_frame);
__EH_FRAME_END__ = ADDR(.eh_frame) + SIZEOF(.eh_frame);
__EXCEPT_START__ = ADDR(.gcc_except_table);
__EXCEPT_END__ = ADDR(.gcc_except_table) + SIZEOF(.gcc_except_table);

/* First symbol in SRAM2 */
/* Last symbol in SRAM2 */
__KRN_TIMER_CTRL_REG = 0x0c000608;

