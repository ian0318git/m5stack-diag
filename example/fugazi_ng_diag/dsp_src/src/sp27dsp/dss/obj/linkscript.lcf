;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; DSS Local Memory
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.provide  _LocMemStart,     0x40000000
.provide  _LocMemBankSize,  64*1024
.provide  _LocMemSize,      _LocMemBankSize * 4
.provide  _LocMemEnd,       _LocMemStart + _LocMemSize

.memory   _LocMemStart,     _LocMemEnd - 1,  "rwx"

.org      _LocMemStart

;.provide _DSSPPB_Cfg, _LocMemStart
;.org _DSSPPB_Cfg

; Packet Driver message queues begin at 0x0
;.segment PktDrvSeg, "PktDrvSeg"
;.no_init "PktDrvSeg"
;.assert(@secsize("PktDrvSeg")>=0x800)

.align 4096
;
; rename .odo_vectors to .odo_vectors_rw as a flag to conv26x to treat the
; section as writeable.  .odo_vectors_rw gets modified to install interrupt handlers for
; the packet driver
;
.rename "*", ".odo_vectors", ".odo_vectors_rw"
.segment   .odovectors, ".odo_vectors_rw"        ; the actual vector table used

.segment   RamCode, "RamCode"
.align  0x100
.segment .ciscoDssBufs, ".ciscoDssBufs"
.segment   .data, ".data", ".bsp_data", ".krn_data", ".ts_data", ".heap_data", ".linx_data", ".cmcl_data"
.segment   .bss, ".bss", ".bsp_bss", ".krn_bss", ".ts_bss", ".heap_bss", ".linx_bss", ".cmcl_bss", "local_siu_sec"
.segment   .pools, ".pool0", ".pool1" 

.provide   _LocHeapStart, @segaddr(".data")+@segsize(".data")

.segment .EOLocal, ".EOLocal"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Stacks
;   NOTE: constants _TopOfStack and _StackStart used by startup.asm (RTLIB)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.provide _TopOfStack,             _LocMemEnd - 4
.provide _NormalStackSize,        3*1024
.provide _UserInterruptStackSize, 2*1024
.provide _StackStart,             _TopOfStack - _NormalStackSize - _UserInterruptStackSize

.reserve _StackStart, _TopOfStack

.no_init ".shMemBufferDss0ToDss1", ".shMemBufferDss0ToDss2", ".shMemBufferDss0ToDss3", ".shMemBufferDss1ToDss0", ".shMemBufferDss1ToDss2", ".shMemBufferDss1ToDss3", ".shMemBufferDss2ToDss0", ".shMemBufferDss2ToDss1", ".shMemBufferDss2ToDss3", ".shMemBufferDss3ToDss0", ".shMemBufferDss3ToDss1", ".shMemBufferDss3ToDss2", ".shMemCtrAreaDss0ToPpb0", ".shMemCtrAreaPpb0ToDss0", ".shMemCtrAreaDss0ToPpb1", ".shMemCtrAreaPpb1ToDss0", ".shMemCtrAreaDss1ToPpb0", ".shMemCtrAreaPpb0ToDss1", ".shMemCtrAreaDss1ToPpb1", ".shMemCtrAreaPpb1ToDss1", ".shMemCtrAreaDss2ToPpb0", ".shMemCtrAreaPpb0ToDss2", ".shMemCtrAreaDss2ToPpb1", ".shMemCtrAreaPpb1ToDss2", ".shMemCtrAreaDss3ToPpb0", ".shMemCtrAreaPpb0ToDss3", ".shMemCtrAreaDss3ToPpb1", ".shMemCtrAreaPpb1ToDss3", ".shMemCtrAreaDss0ToDss1", ".shMemCtrAreaDss1ToDss0", ".shMemCtrAreaDss0ToDss2", ".shMemCtrAreaDss2ToDss0", ".shMemCtrAreaDss0ToDss3", ".shMemCtrAreaDss3ToDss0", ".shMemCtrAreaDss1ToDss2", ".shMemCtrAreaDss2ToDss1", ".shMemCtrAreaDss1ToDss3", ".shMemCtrAreaDss3ToDss1", ".shMemCtrAreaDss2ToDss3", ".shMemCtrAreaDss3ToDss2", ".pool0", ".pool1", ".pool2", ".pool3", ".pool4", ".pool5", ".pool6", ".pool7", ".pool8", ".pool9", ".pool10", ".pool11", ".pool12", ".pool13", ".pool14", ".pool15"

; Prevent dead-data removal
; SR ?? .xref _odo_debug_info

