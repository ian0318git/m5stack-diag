;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Video Libraries
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; h263 library is broken, FIXME (uncomment) when new lib is available
.rename "*", "critical_rom*", ".rom"

.rename "*", "critical_*", ".ctext"
.rename "*", "noncrit_text*", ".noncr_text"
.rename "*", "init_text*", ".noncr_text"
.rename "*", "noncrit_rom*", ".rom"


.org      _SysMemStart
; so that this unreferenced function can be linked in
; SR ?? .xref _pfm_trap_null_function_ptr
.segment  .trap, ".trap"     ; used to trap null function pointer

; intvec must start at 0x1000 (hardcoded in ./sp26/drv-27/ppb/dev/sp_ppb_dev_api.c)
.align 0x1000
.segment  .intvec,    ".intvec"
.provide  _VBAddr, @segaddr(".intvec")
.entry _VBAddr               ; start execution here

.segment  .OS_critical_text, ".OS_critical_text"
.segment  .OS_normal_text, ".OS_normal_text"
.segment  .OS_init_text, ".OS_init_text"

.segment  .text,      ".text", ".perf_funcs", ".perf_funcs_2"
.segment  .ctext,     ".ctext"
.segment  .rodata,    ".rodata"
;.provide  _ROMStart,  @segaddr(".rotable")
.segment  .rotable,   ".init_table"
.segment  .roinit,    ".rom_init", ".staticinit"
.segment  .rom,       ".rom", ".perf_rom"

; put non-critical code on system memory since we still have room for it
; move it to DDR once we are short on system memory
.segment .ddr_text, ".ddr_text", ".noncr_text"
.segment .EOSysROM, ".EOSysROM"

.org      _SysMemStart_RAM
; allocate one bank for each core
.align 0x80000
.segment  .ciscoMemoryBlockL2_DSS0, ".ciscoMemoryBlockL2_DSS0"
.align 0x80000
.segment  .ciscoMemoryBlockL2_DSS1, ".ciscoMemoryBlockL2_DSS1"
.align 0x80000
.segment  .ciscoMemoryBlockL2_DSS2, ".ciscoMemoryBlockL2_DSS2"
.align 0x80000
.segment  .ciscoMemoryBlockL2_DSS3, ".ciscoMemoryBlockL2_DSS3"

;.org      _SharedPoolsMemStart
;.segment  .shared_pools, ".pool3"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Uncached Video Sharing System Memory
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.provide  _VideoShrSysMemStart,    0xC0000000 + _SysMemSize + _SysMemStart
.provide  _VideoShrSysMemBankSize, 512*1024
.provide  _VideoShrSysMemSize,     _VideoShrSysMemBankSize
.provide  _VideoShrSysMemEnd,      _VideoShrSysMemStart + _VideoShrSysMemSize

.memory   _VideoShrSysMemStart,    _VideoShrSysMemEnd - 1, "rwx"

.org      _VideoShrSysMemStart
.segment  .ciscoMemoryUCSysDataHR, ".ciscoMemoryUCSysDataHR"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Uncached System Memory
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.provide  _UncachedSysMemStart,     0xC0000000 + _SysMemSize + _SysMemStart + _VideoShrSysMemSize

.provide  _UncachedSysMemBankSize,  512*1024
.provide  _UncachedSysMemSize,      _UncachedSysMemBankSize * 12 - _SysMemSize - _SysMemStart - _LinxSharedMemTotSize - _VideoShrSysMemSize
.provide  _UncachedSysMemEnd,       _UncachedSysMemStart + _UncachedSysMemSize

.memory   _UncachedSysMemStart, _UncachedSysMemEnd - 1, "rwx"

.org      _UncachedSysMemStart

; For SYSMEM,PCE buffs need to be in uncached memory
.align 0x100
; TDM tx/rx buffers, must be in uncached system memory
.segment  .abu_buffer, ".abu_buffer"
.no_init  ".abu_buffer"

.segment  .shared_data, ".shared_data"

.segment  .trace_buffer_DSS0, ".trace_buffer_DSS0"
.segment  .trace_buffer_DSS1, ".trace_buffer_DSS1"
.segment  .trace_buffer_DSS2, ".trace_buffer_DSS2"
.segment  .trace_buffer_DSS3, ".trace_buffer_DSS3"
.no_init  ".trace_buffer_DSS0", ".trace_buffer_DSS1", ".trace_buffer_DSS2", ".trace_buffer_DSS3"
.segment  .ppb_info, ".ppb_info"

.segment  .systemMemoryUnc, ".systemMemoryUnc"

.align 0x400
.segment  PktDrvPceUCsys, "PktDrvPceUCsys"

;; .segment .ciscoMemoryBlockSU_DSS0, ".ciscoMemoryBlockSU_DSS0"
;; .segment .ciscoMemoryBlockSU_DSS1, ".ciscoMemoryBlockSU_DSS1"
;; .segment .ciscoMemoryBlockSU_DSS2, ".ciscoMemoryBlockSU_DSS2"
;; .segment .ciscoMemoryBlockSU_DSS3, ".ciscoMemoryBlockSU_DSS3"

;; We should have sections for the Shared Memory CM here 
.provide _LinxSharedMemBuffEnd,        0xC0600000
.provide _LinxSharedMemCtrAreaSize,    128
.provide _LinxSharedMemCtrAreaNumber,  28
.provide _LinxSharedMemBuffSize,       4096
.provide _LinxSharedMemBuffNumber,     12
.provide _LinxSharedMemCtrAreaTotSize, _LinxSharedMemCtrAreaNumber * _LinxSharedMemCtrAreaSize
.provide _LinxSharedMemBuffersTotSize, _LinxSharedMemBuffNumber * _LinxSharedMemBuffSize
.provide _LinxSharedMemCtrAreaStart,   _LinxSharedMemBuffEnd - _LinxSharedMemCtrAreaTotSize
.provide _LinxSharedMemTotSize,        _LinxSharedMemCtrAreaTotSize + _LinxSharedMemBuffersTotSize
.provide _LinxSharedMemBuffStart,      _LinxSharedMemCtrAreaStart - _LinxSharedMemBuffersTotSize


;definition for DSS0 / 1 / 2 / 3 to PPB0 / 1 communication

.memory   _LinxSharedMemBuffStart, _LinxSharedMemCtrAreaStart - 1, "rwx"

.org      _LinxSharedMemBuffStart + 0*_LinxSharedMemBuffSize
.segment  .shMemBufferDss0ToDss1, ".shMemBufferDss0ToDss1"
.org      _LinxSharedMemBuffStart + 1*_LinxSharedMemBuffSize
.segment  .shMemBufferDss0ToDss2, ".shMemBufferDss0ToDss2"
.org      _LinxSharedMemBuffStart + 2*_LinxSharedMemBuffSize
.segment  .shMemBufferDss0ToDss3, ".shMemBufferDss0ToDss3"
.org      _LinxSharedMemBuffStart + 3*_LinxSharedMemBuffSize
.segment  .shMemBufferDss1ToDss0, ".shMemBufferDss1ToDss0"
.org      _LinxSharedMemBuffStart + 4*_LinxSharedMemBuffSize
.segment  .shMemBufferDss1ToDss2, ".shMemBufferDss1ToDss2"
.org      _LinxSharedMemBuffStart + 5*_LinxSharedMemBuffSize
.segment  .shMemBufferDss1ToDss3, ".shMemBufferDss1ToDss3"
.org      _LinxSharedMemBuffStart + 6*_LinxSharedMemBuffSize
.segment  .shMemBufferDss2ToDss0, ".shMemBufferDss2ToDss0"
.org      _LinxSharedMemBuffStart + 7*_LinxSharedMemBuffSize
.segment  .shMemBufferDss2ToDss1, ".shMemBufferDss2ToDss1"
.org      _LinxSharedMemBuffStart + 8*_LinxSharedMemBuffSize
.segment  .shMemBufferDss2ToDss3, ".shMemBufferDss2ToDss3"
.org      _LinxSharedMemBuffStart + 9*_LinxSharedMemBuffSize
.segment  .shMemBufferDss3ToDss0, ".shMemBufferDss3ToDss0"
.org      _LinxSharedMemBuffStart + 10*_LinxSharedMemBuffSize
.segment  .shMemBufferDss3ToDss1, ".shMemBufferDss3ToDss1"
.org      _LinxSharedMemBuffStart + 11*_LinxSharedMemBuffSize
.segment  .shMemBufferDss3ToDss2, ".shMemBufferDss3ToDss2"

.memory   _LinxSharedMemCtrAreaStart, _LinxSharedMemBuffEnd - 1, "rwx"

.org      _LinxSharedMemCtrAreaStart + 0*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaDss0ToPpb0, ".shMemCtrAreaDss0ToPpb0"
.org      _LinxSharedMemCtrAreaStart + 1*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaPpb0ToDss0, ".shMemCtrAreaPpb0ToDss0"

.org      _LinxSharedMemCtrAreaStart + 2*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaDss0ToPpb1, ".shMemCtrAreaDss0ToPpb1"
.org      _LinxSharedMemCtrAreaStart + 3*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaPpb1ToDss0, ".shMemCtrAreaPpb1ToDss0"

.org      _LinxSharedMemCtrAreaStart + 4*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaDss1ToPpb0, ".shMemCtrAreaDss1ToPpb0"
.org      _LinxSharedMemCtrAreaStart + 5*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaPpb0ToDss1, ".shMemCtrAreaPpb0ToDss1"

.org      _LinxSharedMemCtrAreaStart + 6*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaDss1ToPpb1, ".shMemCtrAreaDss1ToPpb1"
.org      _LinxSharedMemCtrAreaStart + 7*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaPpb1ToDss1, ".shMemCtrAreaPpb1ToDss1"

.org      _LinxSharedMemCtrAreaStart + 8*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaDss2ToPpb0, ".shMemCtrAreaDss2ToPpb0"
.org      _LinxSharedMemCtrAreaStart + 9*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaPpb0ToDss2, ".shMemCtrAreaPpb0ToDss2"

.org      _LinxSharedMemCtrAreaStart + 10*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaDss2ToPpb1, ".shMemCtrAreaDss2ToPpb1"
.org      _LinxSharedMemCtrAreaStart + 11*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaPpb1ToDss2, ".shMemCtrAreaPpb1ToDss2"

.org      _LinxSharedMemCtrAreaStart + 12*_LinxSharedMemCtrAreaSize
.segment  .shMemCtrAreaDss3ToPpb0, ".shMemCtrAreaDss3ToPpb0"
.org      _LinxSharedMemCtrAreaStart + 13*_LinxSharedMemCtrAreaSize
