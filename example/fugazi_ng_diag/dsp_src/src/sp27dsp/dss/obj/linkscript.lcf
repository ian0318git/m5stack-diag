.provide _SR_Setting, 0x03EC008C    ; The value to set the SR after reset:
    ; all interrupts masked (OSEck startup code will unmask all interrupts)
    ; interrupts disabled
    ; exception mode
    ; saturation on (OSEck startup code enforces this setting)
    ; rounding mode: Twos-complement rounding
   

;;;;;;;;;;;;;;;;
;IMPORTANT NOTE: 
;;;;;;;;;;;;;;;;
    ;- IPL will be forced to 0 (all interrupt unmasked) by OSEck startup code.
    ;- OSEck startup code will force saturation on for both 16 & 32 bits (SM/SM2=1)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; System Memory
; bank 1:  0x00000000  ROM (program)
; bank 2:  0x00080000  ROM (program)
; bank 3:  0x00100000  ROM (program)
; bank 4:  0x00180000  ROM (program)
; bank 5:  0x00200000  ROM (program)
; bank 6:  0x00280000  ROM (program)
; bank 7:  0x00300000  RAM (data)
; bank 8:  0x00380000  RAM (data)
; bank 9:  0x00400000  RAM (data)
; bank 10: 0x00480000  RAM (data)
; bank 11: 0x00500000  Uncached SharedPools (for video cross core sharing)
; bank 12: 0x00580000  UnCached area and CM buffers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

.provide  _SysMemBankSize,      512*1024
.provide  _SysMemStart,         0 *_SysMemBankSize
.provide  _SysMemSize,          _SysMemBankSize * 10
.provide  _SysMemEnd,           _SysMemStart + _SysMemSize
.provide  _SysMemStart_RAM,     _SysMemEnd - _SysMemBankSize * 4

.memory   _SysMemStart,  _SysMemEnd - 1,  "rwx"


