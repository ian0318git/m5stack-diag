;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; PPB Dual Port Memory
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;.memory _DPRAMS_BASE , _DPRAMS_BASE + 512*1024 - 1,	"rw"
;.org _DPRAMS_BASE
;.segment dprams , "dprams"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; DDR3 Cached/Uncached memory

; Layout all memory in the uncached area, then move the
; DDRCacheData and DDRCacheCode to cached space
; Divide up total of 512M (0x20000000) bytes of DDR
;
; Code    32M
; Data    128M
; Uncached Data 95M
; Reserved for ARM 1M
; These will be adjusted as needed
; Put code section first to allow easy MPU protection.
;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.provide _DDRMemStart,      0xF0000000
.provide _DDRCodeMemSize,   0x02000000
.provide _DDRDataMemSize,   0x08000000
.provide _DDRUCMemSize,     0x05F00000
.provide _DDRArmMemSize,    0x00100000

.provide _DDRCodeMemStart, _DDRMemStart
.provide _DDRCodeMemEnd,   _DDRCodeMemStart + _DDRCodeMemSize - 1
.provide _DDRDataMemStart, _DDRCodeMemStart + _DDRCodeMemSize
.provide _DDRDataMemEnd,   _DDRDataMemStart + _DDRDataMemSize - 1
.provide _DDRUCMemStart,   _DDRDataMemStart + _DDRDataMemSize
.provide _DDRUCMemEnd,     _DDRUCMemStart   + _DDRUCMemSize - 1
.provide _DDRArmMemStart,  _DDRUCMemStart   + _DDRUCMemSize
.provide _DDRArmMemEnd,    _DDRArmMemStart  + _DDRArmMemSize - 1
;
; todo, move DDR code to Cached memory
.provide _DDRCacheCodeStart, _DDRCodeMemStart - 0xC0000000 
.provide _DDRCacheCodeEnd,   _DDRCodeMemEnd - 0xC0000000
; data is in Cached memory  
.provide _DDRCacheDataStart, _DDRDataMemStart - 0xC0000000
.provide _DDRCacheDataEnd,   _DDRDataMemEnd - 0xC0000000
;
; Define the sections
;
.memory _DDRCacheCodeStart,  _DDRCacheCodeEnd, "rx"
.memory _DDRCacheDataStart,  _DDRCacheDataEnd, "rw"
.memory _DDRUCMemStart,      _DDRUCMemEnd, "rw"

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; DDR External reserved for ARM - This must match AMRDDR3
; in obj-ppb/linkscript.lcf
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
.reserve _DDRArmMemStart,    _DDRArmMemEnd

.org _DDRCacheCodeStart
;.segment .ddr_text, ".ddr_text", ".noncr_text"
.segment  .osd_font, ".textFontLibrary"

.org _DDRCacheDataStart
.segment  .ciscoMemoryBlockDDR_DSS0, ".ciscoMemoryBlockDDR_DSS0"
.segment  .ciscoMemoryBlockDDR_DSS1, ".ciscoMemoryBlockDDR_DSS1"
.segment  .ciscoMemoryBlockDDR_DSS2, ".ciscoMemoryBlockDDR_DSS2"
.segment  .ciscoMemoryBlockDDR_DSS3, ".ciscoMemoryBlockDDR_DSS3"
.segment  .ciscoMallocDDR_DSS0, ".ciscoMallocDDR_DSS0"
.segment  .ciscoMallocDDR_DSS1, ".ciscoMallocDDR_DSS1"
.segment  .ciscoMallocDDR_DSS2, ".ciscoMallocDDR_DSS2"
.segment  .ciscoMallocDDR_DSS3, ".ciscoMallocDDR_DSS3"
.segment  .rawHdrBufs, ".rawHdrBufs"
.no_init ".rawHdrBufs"
.segment .endOfDDR, ".endOfDDR"

.org _DDRUCMemStart

.align 0x400
.segment  PktDrvPceBuffs, "PktDrvPceBuffs"
.no_init  "PktDrvPceBuffs"

.align 0x100
.segment .ciscoMemoryBlockSU_DSS0, ".ciscoMemoryBlockSU_DSS0"
.align 0x100
.segment .ciscoMemoryBlockSU_DSS1, ".ciscoMemoryBlockSU_DSS1"
.align 0x100
.segment .ciscoMemoryBlockSU_DSS2, ".ciscoMemoryBlockSU_DSS2"
.align 0x100
.segment .ciscoMemoryBlockSU_DSS3, ".ciscoMemoryBlockSU_DSS3"

.no_init "car_regs", "cpf_regs", "dbm_regs", "dcc_regs", "dmac_regs", "ltc_regs"
.no_init "dss_regs", "gpio_regs", "icu_regs", "mac0_regs", "mac1_regs", "mpu_regs"
.no_init "oce_regs", "pcc_regs", "pce0_regs", "pce1_regs", "pci_lcl_regs", "nandflash_regs"
.no_init "pciio_regs", "tdm_regs", "tdm_swtu_ptr_regs", "timer_regs", "txd0_regs", "txd1_regs"
.no_init "wdog_regs", "dprams", "ppb_gpio_regs", "dbm_dmac_g0_regs", "dbm_dmac_g1_regs"
.no_init "ddr3phydp_regs", "ddr3phyadr_regs", "ddr3phytop_regs", "ddr3phydpexternal_regs", "ddr3_regs"
.no_init ".ciscoMem*", ".ciscoMalloc*", ".ciscoDssBufs"

