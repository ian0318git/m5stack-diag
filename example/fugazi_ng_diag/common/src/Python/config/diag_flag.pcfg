#Loop_on_error flag doesn't support in python menu now

$alter_diag_flags: toggle menu
a : toggle "Continuous" flag          : 0 : OFF
  : C
b : toggle "Stop_on_error" flag       : 0 : OFF
  : S
c : toggle "Ext_loopback" flag        : 0 : ON
  : E
d : toggle "Abbr_test" flag           : 0 : OFF
  : A
e : "Loop_on_error" flag(not used on G2 & O2) : 0 : OFF
  : L
f : toggle "Warning" flag             : 0 : OFF
  : W
g : toggle "Trace_mode" flag          : 0 : OFF
  : T
h : toggle "Verbose_mode" flag        : 0 : OFF
  : V
i : toggle "Min_test_time" flag       : 0 : OFF
  : M
j : toggle "Optional_output" flag     : 0 : OFF
  : O
k : toggle "eXec_authentication" flag : 0 : OFF
  : X
l : toggle "permUtation_test" flag    : 0 : OFF
  : U
m : toggle "Debug_option" flag        : 0 : OFF
  : D
n : toggle "ngio_Pwr_after_test" flag : 0 : OFF
  : P
o : toggle "exterNal_customer" flag   : 0 : OFF
  : N

