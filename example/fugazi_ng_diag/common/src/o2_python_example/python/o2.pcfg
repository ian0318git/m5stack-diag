#------------------------------------------------------------------------------
#  Notes that use "#" number sign to make comments in pcfg
#------------------------------------------------------------------------------

###############################################################################
#  Image and Product type selections
###############################################################################
# @image mode : one_big_image (contains all the tests)
#               individual_image (each test has its own executable)
# e.g.
#   @img_mode : one_big_image
###############################################################################
@img_mode : one_big_image

###############################################################################
# @product type : routing (pass all flags as argument of CLI)
#                 2k/3k (no pass flag)
#                 4k
#                 6k
# e.g.
#    @prod_type : routing
###############################################################################
@prod_type : routing

#===================================title=====================================#
#                    menu_keyname : menu_title                                #
#            e.g.                                                             #
#            1.$main_menu         : Python Diag Main Menu                     #
#            2.$motherboard tests : Motherboard Subtest Menu                  #
#=============================================================================#
# main menu MUST use '$main_menu'

$main_menu : Python Diag Main Menu

#===================================body======================================#
#          mitem_letter : mitem_name : mitem_submenu : mitem_flag             #
#                       : mitem_function                                      #
#                                                                             #
#            e.g.     g : motherboard tests : $Motherboard_tests : DOALL      #
#                       : 0                                                   #
#=============================================================================#
# for item i~n in main menu below, executable will use first arg as slot number
# e.g. o2_sm_test below will use first arg "2" as its slot number
# m : test SM Slot 2                  : $test SM Slot 2     : DOALL
#   : o2_sm_test 2
#
# mitem_submenu MUST be the same as in diag_flag.pcfg, (i.e. $alter_diag_flags)
# mitem_submenu MUST be the same as in basic.pcfg (i.e. $basic_utilities)

a : Alter diag flags                : $alter_diag_flags   : 0
  : 0
b : basic utilities                 : 0                   : 0
  : o2x86_lnx basic_util
c : do all diags in this menu       : 0                   : 0
  : do_all
d : do group of diags in this menu  : 0                   : 0
  : do_grp
e : i/o Interface test              : $i/o_interface_test : DOALL
  : o2x86_lnx test IO
f : ACT-2 utilities and programming : 0                   : 0
  : o2x86_lnx auth MB
g : motherboard test                : $Motherboard_tests  : DOALL
  : o2x86_lnx test MB
h : test Data plane                 : $test_data_plane    : DOALL
  : o2x86_lnx test DATA_PLN
i : test WIC Slot 1                 : 0                   : DOALL
  : o2x86_lnx test WIC 1
j : test WIC Slot 2                 : 0                   : DOALL
  : o2x86_lnx test WIC 2
k : test WIC Slot 3                 : 0                   : DOALL
  : o2x86_lnx test WIC 3
l : test SM Slot 1(individual image): $test SM Slot 1(individual image) : DOALL
  : o2_sm_test 1
m : test SM Slot 2                  : $test SM Slot 2     : DOALL
  : o2x86_lnx test SM 2
n : test VM                         : 0                   : DOALL
  : o2x86_lnx test VM 1

$i/o_interface_test : I/O Interface Subtest Menu
a : Alter diag flags               : $alter_diag_flags : 0
  : 0
b : basic utilities                : 0                 : 0
  : 0
c : do all diags in this menu      : 0                 : 0
  : do_all
d : do group of diags in this menu : 0                 : 0
  : do_grp
e : SM interface test              : 0                 : DOALL
  : 0
f : WIC interface test             : 0                 : DOALL
  : 0
g : VM interface test              : 0                 : DOALL
  : 0

$Motherboard_tests : Motherboard Subtest Menu
