#===================================title=====================================#
#                    menu_keyname : menu_title                                #
#                 e.g. $main_menu : LEBOWSKI Module Main Diagnostic Menu      #
#=============================================================================#

$main_menu : LEBOWSKI Module Main Diagnostic Menu


#===================================body======================================#
#          mitem_letter : mitem_name : mitem_submenu : mitem_flag             #
#                       : mitem_function                                      #
#                                                                             #
#       e.g.          e : Smart Cookie Echo Test : 0 : DOALL                  #
#                       : leb_mod_smart_cookie_echo                           #
#=============================================================================#
a : Alter diag flags               : $alter_diag_flags : 0
  : 0
b : basic utilities                : 0                 : 0
  : 0
c : do all diags in this menu      : 0                 : 0
  : do_all
d : do group of diags in this menu : 0                 : 0
  : do_grp
e : Smart Cookie Echo Test         : 0                 : DOALL
  : leb_mod_smart_cookie_echo
f : Lebowski -Host Communication   : 0                 : DOALL
  : leb_mod_host_comm
g : MIC Register Test              : 0                 : DOALL
  : leb_mod_mic_reg
h : MIC Ring Test                  : 0                 : DOALL
  : leb_mod_mic_ring
i : MIC Memory Test                : 0                 : DOALL
  : leb_mod_mic_mem

