#===================================title=====================================#
#                    menu_keyname : menu_title                                #
#        e.g.   $LEBOWSKI 16-port : LEBOWSKI host 16 port Test Menu           #
#=============================================================================#

$LEBOWSKI 16-port : LEBOWSKI host 16 port Test Menu


#===================================body======================================#
#          mitem_letter : mitem_name : mitem_submenu : mitem_flag             #
#                       : mitem_function                                      #
#                                                                             #
#            e.g.     e : OIR (LTC4215) Test : $oir_(LTC4215)_Test : DOALL    #
#                       : 0                                                   #
#=============================================================================#
a : Alter diag flags               : $alter_diag_flags   : 0
  : 0
b : basic utilities                : 0                   : 0
  : 0
c : do all diags in this menu      : 0                   : 0
  : do_all
d : do group of diags in this menu : 0                   : 0
  : do_grp
e : OIR (LTC4215) Test             : $oir_(LTC4215)_Test : DOALL
  : 0
f : Lebowski SM Test               : 0                   : DOALL
  : 0

$oir_(LTC4215)_Test : LTC4215 OIR Subtest Menu
a : Alter diag flags               : $alter_diag_flags   : 0
  : 0
b : basic utilities                : 0                   : 0
  : 0
c : do all diags in this menu      : 0                   : 0
  : do_all
d : do group of diags in this menu : 0                   : 0
  : do_grp
e : OIR (LTC4215) Initialization   : 0                   : DOALL
  : leb_oir_init
f : OIR (LTC4215) Register Test    : 0                   : DOALL
  : leb_oir_LTC4215_reg_test
g : OIR LED Test                   : 0                   : DOALL
  : leb_oir_led_test


